# Copy this file to .env on the server. .env is not committed.

# Shown in the menu. Change this when you release a new version.
APP_VERSION=1.0.0-beta

# This address becomes admin when the site has no admin yet.
# Log in again after changing it.
ADMIN_EMAIL=

# Sender for welcome and playlist mail.
MAIL_FROM=no-reply@homearchive.nl
